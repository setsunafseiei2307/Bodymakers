---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FitnessTool from '../../components/react/FitnessTool';
import '../../styles/tools.css';

const title = '総合身体能力スコア｜懸垂・5km・BIG3・プランク';
const description = '懸垂、5kmランニング、体重比BIG3、プランクを透明なマイルストーンで評価するBodymakers独自の進捗スコア。人口順位や医学的判定ではありません。';
---

<BaseLayout title={title} description={description}>
  <div class="container tool-page">
    <header class="tool-page__header">
      <nav class="breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span>/</span><a href="/tools/">ツール</a><span>/</span><span>総合身体能力</span></nav>
      <p class="tool-page__code">FITNESS ASSESSMENT</p>
      <h1>総合身体能力スコア</h1>
      <p class="tool-page__lead">BIG3だけでは見えない、自重筋力・心肺持久力・体幹を一枚にまとめます。競技者順位とは分け、前回の自分と比べるための指標です。</p>
      <p class="tool-page__privacy">入力は保存・送信されません。</p>
    </header>
    <div class="tool-page__main"><FitnessTool client:load /></div>
    <section class="note" aria-labelledby="score-method"><h2 id="score-method" class="note__title">採点方法</h2><p>体重比BIG3（1〜5倍）、懸垂（1〜20回）、5km（35〜17分30秒）、プランク（30〜180秒）をサイト内の節目として0〜100に線形換算します。これは統計上の平均を意味しません。</p></section>
  </div>
</BaseLayout>
