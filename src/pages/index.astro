---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HomeExperience from '../components/react/HomeExperience';
import { getFeaturedArticles } from '../lib/articles';
import { url } from '../lib/url';
import '../styles/app-shell.css';

const articles = await getFeaturedArticles(3);
---
<BaseLayout>
  <div class="container home-page">
    <HomeExperience client:load />
    {articles.length > 0 && <section class="home-reading"><div><p class="app-kicker">READ & APPLY</p><h2>次の一歩が分かる記事</h2><a href={url('/articles')}>すべての記事を見る →</a></div><div class="card-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></section>}
  </div>
</BaseLayout>
<style>
  .home-page { padding-bottom: 4rem; }
  .home-reading { max-width: 68rem; margin: 0 auto; padding-top: var(--s7); }
  .home-reading > div:first-child { display:flex; align-items:end; justify-content:space-between; gap:var(--s3); margin-bottom:var(--s4); }
  .home-reading > div:first-child a { color:var(--signal); font-size:.85rem; font-weight:800; }
</style>
