---
import ToolLayout from '../../layouts/ToolLayout.astro';
import SmolovTool from '../../components/react/SmolovTool';
import '../../styles/tools.css';

const title = 'Smolov プログラム生成';
const description = '1RMから Smolov（ロシア発の高頻度・高ボリュームなプログラム）の4週間分のメニューを生成します。';
---

<ToolLayout title={title} description={description} toolKey="smolov"
  lead="1RMを入れると、4週間ぶんのメニューが出ます。">
  <SmolovTool client:load />
</ToolLayout>
