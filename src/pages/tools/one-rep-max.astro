---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MaxTool from '../../components/react/MaxTool';
import '../../styles/tools.css';

const title = '1RM換算';
const description = '挙上重量とレップ数から、7つの換算式で1RM（1回だけ挙げられる最大重量）を推定します。余力（RPE）を入れた計算、懸垂やディップスの体重込みの計算にも同じ画面で切り替えられます。';
---

<ToolLayout title={title} description={description} toolKey="oneRm"
  lead="挙げた重量と回数から、1回だけ挙げられる最大重量を推定します。">
  {/* client:load にしているのは、このページの主目的が計算そのもので、
      スクロール前にタップされて反応しない事故を避けるため。 */}
  <MaxTool client:load defaultMode="reps" />
</ToolLayout>
