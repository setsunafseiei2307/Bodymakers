---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FitnessTool from '../../components/react/FitnessTool';
import '../../styles/tools.css';

const title = '総合身体能力スコア';
const description = '懸垂、5kmランニング、体重比BIG3、プランクを透明なマイルストーンで評価するBodymakers独自の進捗スコア。人口順位や医学的判定ではありません。';
---

<ToolLayout title={title} description={description} toolKey="fitness"
  lead="測った種目だけで、筋力・自重・心肺・体幹の現在地を出します。">
  <FitnessTool client:load />

  <details class="ux-details">
    <summary>採点方法</summary>
    <div>
      <p class="ux-note">
        体重比BIG3（1〜5倍）、懸垂（1〜20回）、5km（35〜17分30秒）、プランク（30〜180秒）を
        サイト内の節目として0〜100に線形換算します。これは統計上の平均を意味しません。
      </p>
    </div>
  </details>
</ToolLayout>
