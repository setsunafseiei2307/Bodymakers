---
import ToolLayout from '../../layouts/ToolLayout.astro';
import PlanTool from '../../components/react/PlanTool';
import '../../styles/strength.css';
import '../../styles/tools.css';

const title = 'ダイエット計画';
const description =
  '年齢・性別・身長・体重・活動量・目標日から、TDEE、摂取カロリー、PFC、減量ペース、達成予想日とマイルストーンを計算して端末に保存できます。';
const faqAnswer = 'いいえ。目標が推奨ペースを超える場合は警告し、過度なカロリー制限を勧めない値へ調整します。TDEEも体重変化や日常活動で変わる推定値なので、2〜4週間の実測で見直してください。';
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [{
    '@type': 'Question',
    name: '速く落とすほど良いですか？',
    acceptedAnswer: { '@type': 'Answer', text: faqAnswer },
  }],
};
---

<ToolLayout title={title} description={description} toolKey="plan"
  lead="目標体重と期日から、1日のカロリーとペースを逆算します。"
  privacy="計算はこのブラウザの中だけ。保存ボタンを押した計画だけ、この端末に残ります。">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PlanTool client:load />

  <details class="ux-details">
    <summary>速く落とすほど良いですか？</summary>
    <div><p class="ux-note">{faqAnswer}</p></div>
  </details>
</ToolLayout>
