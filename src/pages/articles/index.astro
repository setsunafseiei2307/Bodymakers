---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getArticlesGroupedByCategory,
  getFeaturedArticles,
  getPublishedArticles,
} from '../../lib/articles';
import { CATEGORIES, type CategoryKey } from '../../config/site';
import { readingMinutes } from '../../lib/readingTime';
import { url } from '../../lib/url';
import '../../styles/ux.css';

/**
 * 記事の入口。
 *
 * 【なぜ作り直したか】
 * 以前は「まず読むなら」3枚＋カテゴリごとに6枚ずつのカードで、
 * スマホで8,700pxあった。カードが120個あり、どれも同じ強さなので、
 * 読みたい記事にたどり着く前に指が疲れる。
 *
 * いまは、
 *   1. 何を知りたい？（カテゴリ4つを選ぶ）
 *   2. まず読むなら（数本だけ）
 *   3. 新着（行のリスト）
 * カテゴリの中身は、それぞれのカテゴリページが持っている。
 * ここで全部を見せる必要はない。
 */

const all = await getPublishedArticles();
const featured = await getFeaturedArticles(3);
const groups = await getArticlesGroupedByCategory();

/** カテゴリごとの説明。何が置いてある棚なのかを1行で示す。 */
const CATEGORY_LEAD: Record<CategoryKey, string> = {
  strength: '自分の強さが競技会の記録と比べてどこにあるか',
  training: '伸ばし方の原則と、メニューの組み方',
  nutrition: '何をどれだけ食べるか',
  diet: '体重を落とすための考え方と、消費カロリーの実際',
};

/** 新着。全部は出さない。続きはカテゴリページへ。 */
const recent = all.slice(0, 8);
---

<BaseLayout
  title="記事一覧"
  description="筋力・トレーニング・栄養・ダイエットについて、出典を示しながら解説しています。記事から対応する計算ツールへそのまま進めます。"
>
  <main class="container ux-page">
    <header class="ux-page__head">
      <h1>何を知りたい？</h1>
      <p>数値はすべて出典のあるものだけを使っています。推測した値は載せません。</p>
    </header>

    <ul class="ux-picker">
      {groups.map(({ category, articles }) => (
        <li>
          <a href={url(`/articles/category/${CATEGORIES[category].slug}`)}>
            <strong>{CATEGORIES[category].label}</strong>
            <small>{CATEGORY_LEAD[category]}</small>
            <span class="num" aria-hidden="true">{articles.length}</span>
          </a>
        </li>
      ))}
    </ul>

    {featured.length > 0 && (
      <section class="ux-section">
        <h2>まず読むなら</h2>
        <ul class="ux-rows">
          {featured.map((article) => (
            <li>
              <a href={url(`/articles/${article.id}`)}>
                <strong>{article.data.title}</strong>
                <small>
                  {CATEGORIES[article.data.category as CategoryKey].label} ・ 約{readingMinutes(article.body ?? '')}分
                </small>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="ux-section">
      <h2>新着</h2>
      <ul class="ux-rows">
        {recent.map((article) => (
          <li>
            <a href={url(`/articles/${article.id}`)}>
              <strong>{article.data.title}</strong>
              <small>
                {CATEGORIES[article.data.category as CategoryKey].label} ・ 約{readingMinutes(article.body ?? '')}分
              </small>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="ux-note">全{all.length}本。続きは上のカテゴリから読めます。</p>
  </main>
</BaseLayout>
