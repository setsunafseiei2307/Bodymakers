---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS } from '../../config/tools';
import AdSlot from '../../components/AdSlot.astro';
import { url } from '../../lib/url';
import NextSteps from '../../components/NextSteps.astro';

const title = 'ツール一覧';
const description =
  '目的から選べる筋力・トレーニング・ダイエット・食事・日々の記録ツール。登録不要、保存する記録はこの端末だけに残ります。';

const purposes = [
  { code: 'ASSESS', title: '総合的な体力を知る', text: '懸垂・5km・BIG3・プランクを一枚にまとめ、次の目標を確認する。', href: '/tools/fitness' },
  { code: 'LIFT', title: 'トレーニング重量を決める', text: '1RM・RPE・%1RM・ウォームアップ・プレートを1画面で計算する。', href: '/tools/one-rep-max' },
  { code: 'DIET', title: '痩せる計画を作る', text: '目標日、摂取カロリー、PFC、マイルストーンをまとめて作る。', href: '/tools/plan' },
  { code: 'LOG', title: '今日の記録をつける', text: '体重・カロリー・タンパク質を10秒で保存し、食事や運動も追加する。', href: '/tools/today' },
  { code: 'FOOD', title: '食事を管理する', text: '料理や食品を調べ、そのまま今日の食事とPFCへ追加する。', href: '/tools/foods' },
  { code: 'PROGRAM', title: 'プログラムを作る', text: '1RM・経験・週の頻度から、次の4週間の重量とセットを作る。', href: '/tools/programs' },
] as const;
---

<BaseLayout title={title} description={description}>
  <div class="container list-page">
    <header class="list-page__header">
      <p class="list-page__code">TOOLS</p>
      <h1>ツール一覧</h1>
      <p class="list-page__lead">
        やりたいことから選んでください。計算はすべてブラウザ内で行い、会員登録もログインも不要です。
        保存した計画と記録はこの端末だけに残り、サーバーには送信されません。
      </p>
    </header>

    <section class="purpose" aria-labelledby="purpose-title">
      <h2 id="purpose-title">目的から選ぶ</h2>
      <ul class="purpose__grid">
        {purposes.map((item) => (
          <li>
            <a href={url(item.href)} class="purpose__card">
              <span>{item.code}</span>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <h2 class="all-tools-title">すべてのツール</h2>

    <ul class="tool-list">
      {
        TOOLS.filter((tool) => tool.key !== 'rpe').map((tool) => (
          <li>
            <a class:list={['tool-card', tool.primary && 'tool-card--primary']} href={url(tool.href)}>
              <span class="tool-card__code">{tool.code}</span>
              <span class="tool-card__name">{tool.label}</span>
              <span class="tool-card__desc">{tool.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <AdSlot id="tools-bottom" />
    <NextSteps title="使い方を解説した記事" tools={[]} articles={true} />
</div>
</BaseLayout>

<style>
  .list-page {
    padding-block: var(--s6) var(--s8);
    max-width: 52rem;
  }

  .list-page__header {
    margin-bottom: var(--s6);
    padding-bottom: var(--s4);
    border-bottom: 3px solid var(--rule);
  }

  .list-page__code {
    color: var(--signal);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .list-page__lead {
    margin-top: var(--s3);
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  .tool-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--hair);
    border: 1px solid var(--hair);
  }

  .purpose { margin-bottom: var(--s7); }
  .purpose > h2,
  .all-tools-title { margin-bottom: var(--s4); font-size: 1.25rem; }
  .purpose__grid { display: grid; gap: var(--s3); margin: 0; padding: 0; list-style: none; }
  .purpose__card { display: block; height: 100%; padding: var(--s4); border: 1px solid var(--hair); border-radius: var(--r-md); background: var(--surface); color: var(--ink); text-decoration: none; }
  .purpose__card:hover { border-color: var(--signal); background: var(--signal-soft); color: var(--ink); }
  .purpose__card > span { display: block; color: var(--signal); font-family: var(--f-mono); font-size: 0.625rem; font-weight: 800; letter-spacing: 0.12em; }
  .purpose__card > strong { display: block; margin-top: var(--s1); font-size: 1rem; }
  .purpose__card > p { margin-top: var(--s2); color: var(--muted); font-size: 0.78rem; line-height: 1.65; }

  @media (min-width: 40rem) {
    .purpose__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 40rem) {
    .tool-list { grid-template-columns: 1fr 1fr; }
  }

  .tool-card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: var(--s1);
    height: 100%;
    padding: var(--s4);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .tool-card:hover {
    background: var(--inset);
    color: var(--ink);
  }

  .tool-card__code {
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .tool-card__name {
    font-size: 1.0625rem;
    font-weight: 900;
  }

  .tool-card:hover .tool-card__name { color: var(--signal); }

  .tool-card__desc {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  /* 診断は主軸の機能なので、一覧の中でも一段強調する */
  .tool-card--primary {
    background: var(--signal-soft);
  }

  .tool-card--primary .tool-card__code { color: var(--signal); }

  @media (min-width: 40rem) {
    .tool-card--primary { grid-column: 1 / -1; }
  }
</style>
