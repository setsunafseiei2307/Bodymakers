---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, SITE_NAME, type CategoryKey } from '../config/site';
import { formatDate, toISODate, type Article } from '../lib/articles';
import AdSlot from '../components/AdSlot.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ToolCta from '../components/ToolCta.astro';
import { readingMinutes } from '../lib/readingTime';
import { url } from '../lib/url';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: Article;
  related: Article[];
  /** 目次に使う見出し。render() が返すものをそのまま渡す */
  headings: Heading[];
  /** 書き手が指定した「次に読む」記事。無ければ関連記事だけ出す */
  nextArticle?: Article;
}

const { article, related, headings, nextArticle } = Astro.props;
const minutes = readingMinutes(article.body ?? '');
const { data } = article;
const category = CATEGORIES[data.category as CategoryKey];

/**
 * 構造化データ。記事が検索結果でリッチに扱われるようにする。
 * 著者は個人名を出さずサイト名にしている（運営者情報は /about に置く）。
 */
/**
 * パンくずの構造化データ。
 * 画面にはパンくずを出していたのに、検索エンジンには伝えていなかった。
 * 検索結果でカテゴリまでの階層が表示されるようになる。
 */
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'ホーム', path: '/' },
    { name: '記事', path: '/articles' },
    { name: category.label, path: `/articles/category/${category.slug}` },
    { name: data.title, path: Astro.url.pathname },
  ].map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(url(item.path), Astro.site ?? Astro.url.origin).href,
  })),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: toISODate(data.publishedAt),
  dateModified: toISODate(data.updatedAt ?? data.publishedAt),
  author: { '@type': 'Organization', name: SITE_NAME },
  publisher: { '@type': 'Organization', name: SITE_NAME },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href,
  image: new URL(url(`/og/${article.id}.png`), Astro.site ?? Astro.url.origin).href,
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogType="article"
  ogImage={`/og/${article.id}.png`}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbData)}
  />

  <div class="container article-page">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href={url('/')}>ホーム</a></li>
        <li><a href={url('/articles')}>記事</a></li>
        <li>
          <a href={url(`/articles/category/${category.slug}`)}>{category.label}</a>
        </li>
      </ol>
    </nav>

    <article class="prose-container">
      <header class="article-header">
        <div class="article-header__meta">
          <span class="tag">{category.label}</span>
          <time datetime={toISODate(data.publishedAt)}>
            {formatDate(data.publishedAt)} 公開
          </time>
          {
            data.updatedAt && (
              <time datetime={toISODate(data.updatedAt)}>
                {formatDate(data.updatedAt)} 更新
              </time>
            )
          }
          <span>約{minutes}分で読めます</span>
        </div>
        <h1>{data.title}</h1>
        <p class="article-header__description">{data.description}</p>
        {
          data.tags.length > 0 && (
            <ul class="article-header__tags">
              {data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )
        }
      </header>

      {
        data.takeaways.length > 0 && (
          <section class="takeaways" aria-labelledby="takeaways-title">
            <h2 class="takeaways__title" id="takeaways-title">
              この記事で分かること
            </h2>
            <ul class="takeaways__list">
              {data.takeaways.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      <ArticleToc headings={headings} />

      <div class="article-body">
        <slot />
      </div>

      {
        data.references.length > 0 && (
          <section class="references">
            <h2 class="references__title">参考文献・出典</h2>
            <ol class="references__list">
              {data.references.map((reference) => (
                <li>
                  {reference.url ? (
                    <a href={reference.url} target="_blank" rel="noopener noreferrer">
                      {reference.title}
                    </a>
                  ) : (
                    <span>{reference.title}</span>
                  )}
                  {reference.note && <span class="references__note">{reference.note}</span>}
                </li>
              ))}
            </ol>
            <p class="references__more">
              <a href={url('/sources')}>当サイトが使っているデータの出どころ</a>
            </p>
          </section>
        )
      }

      <div class="note note--warn article-disclaimer">
        <span class="note__title">ご注意</span>
        <p>
          本記事は一般的な情報提供を目的としたものであり、医学的な診断・治療・指導を
          行うものではありません。効果には個人差があり、
          特定の結果を保証するものではありません。
          既往症がある場合や体調に不安がある場合は、医療機関にご相談ください。
        </p>
      </div>

      {/* 広告枠（記事末尾）。現時点では広告タグを読み込まない。
          アフィリエイトリンク（書籍・器具・サプリメント等）を差し込む場合も、
          本文とは区別できるようこのブロック内に置き、PR表記を添えること。 */}
      <AdSlot id="article-end" />

      {/* 記事ごとに行き先が変わる導線。primaryTool が無い記事では出ない。 */}
      <ToolCta toolKey={data.primaryTool} label={data.ctaLabel} query={data.toolQuery} />
    </article>

    {
      nextArticle && (
        <section class="next-up">
          <h2 class="next-up__title">次に読む</h2>
          <ArticleCard article={nextArticle} />
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="related">
          <div class="section-head">
            <h2>{nextArticle ? 'ほかの関連記事' : '関連記事'}</h2>
            <a href={url(`/articles/category/${category.slug}`)}>
              {category.label}の記事をもっと見る
            </a>
          </div>
          <div class="card-grid">
            {related.map((item) => (
              <ArticleCard article={item} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .article-page {
    padding-block: var(--s5) var(--s8);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s5);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--s2);
    color: var(--rule);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--signal);
    text-decoration: underline;
  }

  .article-header {
    padding-bottom: var(--s5);
    margin-bottom: var(--s6);
    border-bottom: 1px solid var(--hair);
  }

  .article-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s3);
    margin-bottom: var(--s4);
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .article-header__description {
    margin-top: var(--s4);
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin-top: var(--s4);
    padding: 0;
    list-style: none;
  }

  .references {
    margin-top: var(--s7);
    padding: var(--s5);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    background: var(--inset);
  }

  .references__title {
    margin-bottom: var(--s3);
    font-size: 1rem;
  }

  .references__list {
    margin: 0;
    padding-left: 1.4em;
    color: var(--body);
    font-size: 0.875rem;
    line-height: 1.9;
  }

  .references__list li + li {
    margin-top: var(--s2);
  }

  .references__note {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .article-disclaimer {
    margin-top: var(--s6);
  }

  /* 冒頭の「この記事で分かること」。
     検索から来た人が、読む前に自分の疑問と合っているか判断できるようにする。 */
  .takeaways {
    margin-top: var(--s5);
    padding: var(--s5);
    border-left: 3px solid var(--signal);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    background: var(--inset);
  }

  .takeaways__title {
    margin-bottom: var(--s3);
    font-size: 0.9375rem;
  }

  .takeaways__list {
    margin: 0;
    padding-left: 1.3em;
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  .takeaways__list li + li {
    margin-top: var(--s2);
  }

  .references__more {
    margin-top: var(--s4);
    font-size: 0.8125rem;
  }

  .next-up {
    margin-top: var(--s8);
    padding-top: var(--s6);
    border-top: 1px solid var(--hair);
  }

  .next-up__title {
    margin-bottom: var(--s4);
    font-size: 1.125rem;
  }

  .related {
    margin-top: var(--s7);
  }

  /* 「次に読む」が無いときだけ、関連記事の上に区切り線を置く */
  .next-up + .related {
    padding-top: 0;
    border-top: none;
  }

  .article-page > .related:not(.next-up + .related) {
    margin-top: var(--s8);
    padding-top: var(--s6);
    border-top: 1px solid var(--hair);
  }

  .card-grid {
    display: grid;
    gap: var(--s4);
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }
</style>
