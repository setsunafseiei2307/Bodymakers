---
import { FOOTER_ITEMS, SITE_NAME, SITE_TAGLINE } from '../config/site';
import AdSlot from './AdSlot.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <!-- 広告枠（フッター）。現時点では広告タグを読み込まない。
         有効化するときはこの div の中にタグを入れる。 -->
    <AdSlot id="footer" variant="footer" />

    <div class="site-footer__inner">
      <div class="site-footer__brand">
        <p class="site-footer__name">{SITE_NAME}</p>
        <p class="site-footer__tagline">{SITE_TAGLINE}</p>
      </div>

      <nav class="site-footer__nav" aria-label="フッターナビゲーション">
        <ul class="site-footer__list">
          {
            FOOTER_ITEMS.map((item) => (
              <li>
                <a class="site-footer__link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="site-footer__legal">
      本サイトの内容は一般的な情報提供を目的としたものであり、医学的な診断・治療・指導を
      行うものではありません。健康状態に不安がある場合は医療機関にご相談ください。
    </p>

    <p class="site-footer__copyright">© {year} {SITE_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--s6) var(--s7);
    background: var(--surface);
    border-top: 1px solid var(--hair);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s5);
    padding-bottom: var(--s5);
    border-bottom: 1px solid var(--hair);
  }

  .site-footer__name {
    color: var(--ink);
    font-weight: 800;
    font-size: 1.0625rem;
  }

  .site-footer__tagline {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .site-footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link {
    color: var(--body);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .site-footer__link:hover {
    color: var(--signal);
    text-decoration: underline;
  }

  .site-footer__legal {
    margin-top: var(--s5);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  .site-footer__copyright {
    margin-top: var(--s4);
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
