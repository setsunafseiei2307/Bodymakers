---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NutritionTool from '../../components/react/NutritionTool';
import '../../styles/tools.css';
import AdSlot from '../../components/AdSlot.astro';
import { url } from '../../lib/url';
import ToolArticles from '../../components/ToolArticles.astro';

const title = 'PFC・カロリー計算';
const description = '基礎代謝と活動量から1日の消費カロリーを求め、目標に応じたカロリーとPFC（たんぱく質・脂質・炭水化物）の配分を計算します。';

/*
 * 画面にはパンくずを出していたが、検索エンジンには伝えていなかった。
 * ArticleLayout と同じ形で階層を渡す。
 */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { name: 'ホーム', path: '/' },
    { name: 'ツール', path: '/tools' },
    { name: title, path: Astro.url.pathname },
  ].map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(url(item.path), Astro.site ?? Astro.url.origin).href,
  })),
};

/* 画面に出している文と同じ内容だけを構造化データにする。 */
const faqs = [
  {
    question: 'この数字どおりに食べれば必ず痩せますか？',
    answer: '計算式はいずれも統計的な推定で、実際の代謝には個人差があります。2〜3週間続けて体重の変化を見ながら、増減がなければ少しずつ調整してください。',
  },
  {
    question: '体脂肪率は入れないとだめですか？',
    answer: '年齢・身長・体重の3つだけで計算できます。体脂肪率を入れると除脂肪体重が出せるので、Katch-McArdle式が選べるようになります。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="container tool-page">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href={url('/')}>ホーム</a></li>
        <li><a href={url('/tools')}>ツール</a></li>
      </ol>
    </nav>

    <header class="tool-page__header">
      <p class="tool-page__code">栄養ツール</p>
      <h1>{title}</h1>
      <p class="tool-page__lead">{description}</p>
      <p class="tool-page__privacy">無料 ・ 登録不要 ・ 入力した内容は送信も保存もされません。</p>
    </header>

    {/* client:load にしているのは、このページの主目的が計算そのもので、
        スクロール前にタップされて反応しない事故を避けるため。 */}
    <NutritionTool client:load />

    <section class="nutri nutri-card nutri-faq" aria-labelledby="nutri-faq-title">
      <h2 id="nutri-faq-title">よくある質問</h2>
      <dl>
        {faqs.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>

    <p class="nutri-related">計算の背景や、実際の食事への落とし込みは記事でも解説しています。</p>

    <ToolArticles toolKey="nutrition" />

    <AdSlot id="tool-bottom" />
  </div>
</BaseLayout>

<style>
  .tool-page {
    padding-block: var(--s5) var(--s8);
    max-width: 52rem;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s5);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--s2);
    color: var(--hair);
  }

  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--signal); }

  .tool-page__header {
    margin-bottom: var(--s5);
    padding-bottom: var(--s4);
  }

  .tool-page__code {
    color: var(--signal);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .tool-page__lead {
    margin-top: var(--s3);
    color: var(--body);
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  .tool-page__privacy {
    margin-top: var(--s2);
    color: var(--muted);
    font-size: 0.75rem;
  }

  .nutri-related {
    margin-top: var(--s6);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.8;
  }
</style>
