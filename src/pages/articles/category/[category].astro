---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticlesByCategory } from '../../../lib/articles';
import { CATEGORIES, type CategoryKey } from '../../../config/site';
import type { ToolKey } from '../../../config/tools';
import { url } from '../../../lib/url';
import NextSteps from '../../../components/NextSteps.astro';

/**
 * カテゴリ別の一覧。
 * 記事が0件のカテゴリでもページ自体は生成する
 * （ナビから飛べるリンクが404にならないようにするため。空状態を表示する）。
 */
export function getStaticPaths() {
  return Object.values(CATEGORIES).map((category) => ({
    params: { category: category.slug },
  }));
}

const { category: slug } = Astro.params;
const category = CATEGORIES[slug as CategoryKey];
const articles = await getArticlesByCategory(slug as string);

/**
 * カテゴリごとの説明と、そのカテゴリから使うツール。
 *
 * 一覧を見に来た人は、まだ読む記事を決めていない。
 * 「この棚には何が置いてあるか」を1行で示し、
 * 記事を読まずにツールへ行きたい人の出口も用意しておく。
 */
const CATEGORY_INFO: Record<
  CategoryKey,
  { lead: string; tools: ToolKey[] }
> = {
  strength: {
    lead: '自分の強さが競技会の記録と比べてどこにあるかを、実データで示します。',
    tools: ['strength', 'oneRm'],
  },
  training: {
    lead: '伸ばし方の原則と、メニューの組み方。',
    tools: ['oneRm', 'rpe', 'today'],
  },
  nutrition: {
    lead: '何をどれだけ食べるか。数値はすべて食品成分表の収載値です。',
    tools: ['nutrition', 'foods'],
  },
  diet: {
    lead: '体重を落とすための考え方と、消費カロリーの実際。',
    tools: ['plan', 'burn', 'today'],
  },
};

const info = CATEGORY_INFO[slug as CategoryKey];
---

<BaseLayout
  title={`${category.label}の記事`}
  description={`${category.label}に関する記事の一覧です。`}
>
  <div class="container list-page">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href={url('/')}>ホーム</a></li>
        <li><a href={url('/articles')}>記事</a></li>
      </ol>
    </nav>

    <header class="list-page__header">
      <h1>{category.label}</h1>
      <p class="list-page__lead">{info.lead}</p>
      <p class="list-page__count">
        {articles.length > 0 ? `${articles.length}本` : 'まだ記事がありません'}
      </p>
    </header>

    <nav class="category-nav" aria-label="カテゴリ">
      <ul>
        <li><a class="category-nav__link" href={url('/articles')}>すべて</a></li>
        {
          Object.values(CATEGORIES).map((item) => (
            <li>
              <a
                class:list={[
                  'category-nav__link',
                  item.slug === slug && 'category-nav__link--active',
                ]}
                href={url(`/articles/category/${item.slug}`)}
                aria-current={item.slug === slug ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* カードの見出しが h3 なので、その上に h2 を置いて階層を飛ばさない */}
    <h2 class="cat-list__title">{category.label}の記事</h2>

    {
      articles.length > 0 ? (
        <div class="card-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <strong class="empty__title">記事はまだありません</strong>
          <p>
            <a href={url('/articles')}>すべての記事を見る</a>
          </p>
        </div>
      )
    }
    <NextSteps title={`${category.label}で使うツール`} tools={info.tools} articles={false} />
</div>
</BaseLayout>

<style>
  .list-page {
    padding-block: var(--s5) var(--s8);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s5);
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: var(--s2);
    color: var(--rule);
  }

  .breadcrumb a {
    color: var(--muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--signal);
    text-decoration: underline;
  }

  .list-page__header {
    margin-bottom: var(--s5);
  }

  .cat-list__title {
    margin-bottom: var(--s4);
    font-size: 1rem;
  }

  .list-page__count {
    margin-top: var(--s3);
    color: var(--signal);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .list-page__lead {
    margin-top: var(--s3);
    color: var(--muted);
    font-size: 1rem;
  }

  .category-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s6);
    padding: 0;
    list-style: none;
  }

  .category-nav__link {
    display: inline-block;
    padding: var(--s2) var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--r-full);
    color: var(--body);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-nav__link:hover {
    border-color: var(--signal);
    background: var(--signal-soft);
    color: var(--signal);
  }

  .category-nav__link--active {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--paper);
  }

  .category-nav__link--active:hover {
    background: var(--signal);
    color: var(--paper);
  }

  .card-grid {
    display: grid;
    gap: var(--s4);
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }
</style>
