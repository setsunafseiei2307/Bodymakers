---
import ToolLayout from '../../layouts/ToolLayout.astro';
import MaxTool from '../../components/react/MaxTool';
import '../../styles/tools.css';

const title = 'RPE換算';
const description = 'RPE（あと何回できたか）と実施したセットから1RMを逆算し、次のセットの目安重量表を出します。レップ数だけの換算、懸垂やディップスの体重込みの計算にも同じ画面で切り替えられます。';
---

<ToolLayout title={title} description={description} toolKey="rpe"
  lead="重量・回数・あと何回できたか（RPE）から、1RMと次の目安重量を出します。">
  <MaxTool client:load defaultMode="rpe" />
</ToolLayout>
