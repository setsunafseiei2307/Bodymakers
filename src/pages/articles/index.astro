---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/articles';
import { CATEGORIES } from '../../config/site';
import AdSlot from '../../components/AdSlot.astro';
import { url } from '../../lib/url';

const articles = await getPublishedArticles();
---

<BaseLayout
  title="記事一覧"
  description="トレーニング・栄養・基礎知識に関する記事の一覧です。"
>
  <div class="container list-page">
    <header class="list-page__header">
      <h1>記事一覧</h1>
      <p class="list-page__lead">
        トレーニング・栄養・基礎知識について、根拠を示しながら解説しています。
      </p>
    </header>

    <nav class="category-nav" aria-label="カテゴリ">
      <ul>
        <li><a class="category-nav__link category-nav__link--active" href={url('/articles')}>すべて</a></li>
        {
          Object.values(CATEGORIES).map((category) => (
            <li>
              <a class="category-nav__link" href={url(`/articles/category/${category.slug}`)}>
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      articles.length > 0 ? (
        <div class="card-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <div class="empty">
          <strong class="empty__title">記事はまだありません</strong>
          <p>
            src/content/articles/ に Markdown ファイルを置くと、ここに一覧が出ます。
          </p>
        </div>
      )
    }

    {/* 広告枠（一覧下部）。現時点では広告タグを読み込まない。 */}
    <AdSlot id="list-bottom" />
  </div>
</BaseLayout>

<style>
  .list-page {
    padding-block: var(--s6) var(--s8);
  }

  .list-page__header {
    margin-bottom: var(--s5);
  }

  .list-page__lead {
    margin-top: var(--s3);
    color: var(--muted);
    font-size: 1rem;
  }

  .category-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
    margin: 0 0 var(--s6);
    padding: 0;
    list-style: none;
  }

  .category-nav__link {
    display: inline-block;
    padding: var(--s2) var(--s4);
    border: 1px solid var(--rule);
    border-radius: var(--r-full);
    color: var(--body);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-nav__link:hover {
    border-color: var(--signal);
    background: var(--signal-soft);
    color: var(--signal);
  }

  .category-nav__link--active {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--paper);
  }

  .category-nav__link--active:hover {
    background: var(--signal);
    color: var(--paper);
  }

  .card-grid {
    display: grid;
    gap: var(--s4);
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }
</style>
