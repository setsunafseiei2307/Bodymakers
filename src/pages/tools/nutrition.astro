---
import ToolLayout from '../../layouts/ToolLayout.astro';
import NutritionTool from '../../components/react/NutritionTool';
import '../../styles/tools.css';

const title = 'PFC・カロリー計算';
const description = '基礎代謝と活動量から1日の消費カロリーを求め、目標に応じたカロリーとPFC（たんぱく質・脂質・炭水化物）の配分を計算します。';

/* 画面に出している文と同じ内容だけを構造化データにする。 */
const faqs = [
  {
    question: 'この数字どおりに食べれば必ず痩せますか？',
    answer: '計算式はいずれも統計的な推定で、実際の代謝には個人差があります。2〜3週間続けて体重の変化を見ながら、増減がなければ少しずつ調整してください。',
  },
  {
    question: '体脂肪率は入れないとだめですか？',
    answer: '年齢・身長・体重の3つだけで計算できます。体脂肪率を入れると除脂肪体重が出せるので、Katch-McArdle式が選べるようになります。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<ToolLayout title={title} description={description} toolKey="nutrition"
  lead="身長・体重・活動量から、1日のカロリーとPFCの目安を出します。">
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <NutritionTool client:load />

  {/* よくある質問。読まなくても計算はできるので、開いたときだけ見せる。 */}
  <div class="tool-faq">
    {faqs.map((item) => (
      <details class="ux-details">
        <summary>{item.question}</summary>
        <div><p class="ux-note">{item.answer}</p></div>
      </details>
    ))}
  </div>
</ToolLayout>
