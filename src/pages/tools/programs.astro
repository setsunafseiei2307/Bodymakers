---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ProgramTool from '../../components/react/ProgramTool';
import '../../styles/tools.css';

const title = 'プログラムを探す';
const description = '目的・頻度・トレーニング歴から自分に合う筋トレプログラムを選び、保存済み1RMを実際に組める重量へ変換します。';
---

<ToolLayout title={title} description={description} toolKey="programs"
  lead="やりたいことを選ぶと、それに合うメニューが出ます。"
  privacy="計算はこのブラウザの中だけ。開始したプログラムだけ、この端末に残ります。">
  <ProgramTool client:load />
</ToolLayout>
