---
import { NAV_ITEMS, SITE_SHORT_NAME } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
import { sitePath, url } from '../lib/url';

const pathname = sitePath(Astro.url.pathname);
function isCurrent(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href={url('/')} aria-label={`${SITE_SHORT_NAME} ホーム`}>
      <svg class="site-header__mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="2" y="12.5" width="4" height="7" rx="1.5" fill="currentColor"/><rect x="6.5" y="9.5" width="4.5" height="13" rx="1.5" fill="currentColor"/><rect x="11" y="14.5" width="10" height="3" fill="currentColor"/><rect x="21" y="9.5" width="4.5" height="13" rx="1.5" fill="currentColor"/><rect x="26" y="12.5" width="4" height="7" rx="1.5" fill="currentColor"/></svg>
      <span class="site-header__name">{SITE_SHORT_NAME}</span>
    </a>
    <nav class="site-header__nav" aria-label="メインナビゲーション"><ul>{NAV_ITEMS.map((item) => <li><a href={url(item.href)} class:list={[item.primary && 'is-primary']} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
    <ThemeToggle />
  </div>
</header>
<style>
.site-header { position:sticky; top:0; z-index:20; background:color-mix(in srgb, var(--paper) 82%, transparent); backdrop-filter:blur(18px); border-bottom:1px solid color-mix(in srgb, var(--hair) 80%, transparent); }
.site-header__inner { display:flex; align-items:center; min-height:4.25rem; gap:var(--s3); }.site-header__logo { display:inline-flex; align-items:center; gap:.6rem; color:var(--ink); font-size:1.05rem; font-weight:900; text-decoration:none; }.site-header__mark { width:2rem; color:var(--signal); }.site-header__nav { flex:1; }.site-header__nav ul { display:flex; justify-content:flex-end; gap:.2rem; margin:0; padding:0; list-style:none; }.site-header__nav a { display:inline-flex; min-height:2.75rem; align-items:center; padding:0 .8rem; border-radius:var(--r-full); color:var(--body); font-size:.85rem; font-weight:800; text-decoration:none; }.site-header__nav a:hover, .site-header__nav a[aria-current='page'] { background:var(--signal-soft); color:var(--signal); }.site-header__nav a.is-primary { background:var(--signal); color:white; }
@media (max-width:47.99rem) { .site-header { position:sticky; }.site-header__inner { min-height:3.75rem; }.site-header__nav { display:none; }.site-header__name { font-size:1rem; } }
</style>
