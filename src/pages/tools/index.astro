---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS } from '../../config/tools';
import { url } from '../../lib/url';
import '../../styles/ux.css';

/*
 * ツールの入口。
 *
 * 【なぜカードを並べるのをやめたか】
 * 以前は「目的から選ぶ」6枚のカードと「すべてのツール」10枚のカードが
 * 縦に並んでいた。はじめて来た人にとっては同じ強さのカードが16枚あるだけで、
 * RPE / Smolov / DOTS のような専門語も同じ大きさで混ざっていた。
 * どれを押せばいいのか決められない。
 *
 * いまは「何をしたい？」から先に選ばせる。専門家向けの一覧は残すが、
 * 開いた直後には見せず details の中へ畳む。
 */

const title = 'ツール';
const description =
  '目的から選ぶ、身体づくりの計算ツール。登録不要でその場で計算でき、保存した記録はこの端末だけに残ります。';

/**
 * 「何をしたい？」。専門語（RPE / Smolov / DOTS）はここに出さない。
 * 初心者が最初に選ぶ場所なので、選択肢は自分の言葉で書ける6つだけ。
 */
const purposes = [
  { title: '身体を変えたい', text: '目標から逆算して、痩せる計画を作る。', href: '/tools/plan' },
  { title: '自分の身体を知りたい', text: '筋力・体力がいまどのくらいかを測る。', href: '/tools/fitness' },
  { title: '筋トレしたい', text: '扱う重量とメニューを決める。', href: '/tools/programs' },
  { title: '食事を整えたい', text: '1日のカロリーとPFCの目安を出す。', href: '/tools/nutrition' },
  { title: 'カロリーを知りたい', text: '食品・料理のカロリーとPFCを調べる。', href: '/tools/foods' },
  { title: '記録したい', text: '今日の食事・トレーニング・体重を残す。', href: '/tools/today' },
] as const;
---

<BaseLayout title={title} description={description}>
  <main class="container ux-page">
    <header class="ux-page__head">
      <h1>何をしたい？</h1>
      <p>選ぶとそのまま使えるツールへ進みます。登録は要りません。</p>
    </header>

    <ul class="ux-picker">
      {purposes.map((item) => (
        <li>
          <a href={url(item.href)}>
            <strong>{item.title}</strong>
            <small>{item.text}</small>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>

    {/*
      専門家向けの一覧。検索で直接ツール名を知っている人のために残すが、
      初心者が最初に見る場所には置かない。
    */}
    <details class="ux-details">
      <summary>すべてのツールを見る（{TOOLS.length}件）</summary>
      <div>
        <ul class="ux-rows">
          {TOOLS.map((tool) => (
            <li>
              <a href={url(tool.href)}>
                <strong>{tool.label}</strong>
                <small>{tool.summary}</small>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </details>

    <p class="ux-note">
      計算はすべてこのブラウザの中で行います。入力した内容はサーバーへ送信されません。
    </p>
  </main>
</BaseLayout>
