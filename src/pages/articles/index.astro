---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/articles';
import { CATEGORIES } from '../../config/site';

const articles = await getPublishedArticles();
---

<BaseLayout
  title="記事一覧"
  description="トレーニング・栄養・基礎知識に関する記事の一覧です。"
>
  <div class="container list-page">
    <header class="list-page__header">
      <h1>記事一覧</h1>
      <p class="list-page__lead">
        トレーニング・栄養・基礎知識について、根拠を示しながら解説しています。
      </p>
    </header>

    <nav class="category-nav" aria-label="カテゴリ">
      <ul>
        <li><a class="category-nav__link category-nav__link--active" href="/articles">すべて</a></li>
        {
          Object.values(CATEGORIES).map((category) => (
            <li>
              <a class="category-nav__link" href={`/articles/category/${category.slug}`}>
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      articles.length > 0 ? (
        <div class="card-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <strong class="empty-state__title">記事はまだありません</strong>
          <p>
            src/content/articles/ に Markdown ファイルを置くと、ここに一覧が出ます。
          </p>
        </div>
      )
    }

    {/* 広告枠（一覧下部）。現時点では広告タグを読み込まない。 */}
    <div class="ad-slot ad-slot--inline" aria-hidden="true" data-ad-slot="list-bottom"></div>
  </div>
</BaseLayout>

<style>
  .list-page {
    padding-block: var(--space-6) var(--space-8);
  }

  .list-page__header {
    margin-bottom: var(--space-5);
  }

  .list-page__lead {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: 1rem;
  }

  .category-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .category-nav__link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
    color: var(--text-body);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-nav__link:hover {
    border-color: var(--brand);
    background: var(--brand-soft);
    color: var(--brand-text);
  }

  .category-nav__link--active {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--text-inverse);
  }

  .category-nav__link--active:hover {
    background: var(--brand-hover);
    color: var(--text-inverse);
  }

  .card-grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }
</style>
