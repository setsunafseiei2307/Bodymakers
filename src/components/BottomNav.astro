---
/*
 * スマホの下部ナビゲーション。
 *
 * 【なぜ Today / Plan / Record / Library をやめたか】
 * 以前の4つは、すでに毎日使っている人の作業画面の名前だった。
 * はじめて来た人は「Today？ Library？」で止まってしまい、
 * サイトが何をするところなのか分からないまま迷子になっていた。
 *
 * いま並べるのは、来た人がやりたいことの言葉:
 *   ホーム / 診断 / ツール / 記事 / マイ
 * 個人の記録は「マイ」(/personal) の下にまとめてあり、
 * 使いたい人だけがそこから入る。URLは変えていない。
 *
 * 親指だけで押せるよう、1つあたりの幅は5等分・高さは44px以上を確保する。
 */
import { sitePath, url } from '../lib/url';

const pathname = sitePath(Astro.url.pathname);

/** アイコンは装飾。意味は必ずラベル側のテキストが持つ。 */
const items = [
  { href: '/', label: 'ホーム', icon: 'home' },
  { href: '/start', label: '診断', icon: 'compass' },
  { href: '/tools', label: 'ツール', icon: 'tool' },
  { href: '/articles', label: '記事', icon: 'book' },
  { href: '/personal', label: 'マイ', icon: 'person' },
] as const;

/**
 * 現在地の判定。
 * Personalは配下の作業画面（Today / Plan / Record）を開いている間も
 * 「マイ」を現在地として光らせる。ユーザーの体感ではその中にいるため。
 */
const PERSONAL_PATHS = ['/personal', '/tools/today', '/plan', '/record', '/library'];

function isCurrent(href: string): boolean {
  if (href === '/') return pathname === '/';
  if (href === '/personal') {
    return PERSONAL_PATHS.some((p) => pathname === p || pathname.startsWith(`${p}/`));
  }
  if (href === '/tools') {
    // Todayは「マイ」側の担当なので、ツールの現在地には含めない
    if (pathname === '/tools/today') return false;
    return pathname === '/tools' || pathname.startsWith('/tools/');
  }
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<nav class="app-bottom-nav" aria-label="メインナビゲーション">
  {items.map((item) => (
    <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {item.icon === 'home' && <path d="M4 11l8-7 8 7M6 9.5V20h12V9.5" />}
        {item.icon === 'compass' && <><circle cx="12" cy="12" r="8.5" /><path d="M15.2 8.8l-2 4.4-4.4 2 2-4.4z" /></>}
        {item.icon === 'tool' && <path d="M5 18l7-7M9.5 6.5L12 4l3 1 1 3-2.5 2.5M14 14l4 4" />}
        {item.icon === 'book' && <path d="M5 5h6v14H5zM13 5h6v14h-6" />}
        {item.icon === 'person' && <><circle cx="12" cy="8.5" r="3.5" /><path d="M5.5 19.5a6.5 6.5 0 0113 0" /></>}
      </svg>
      <small>{item.label}</small>
    </a>
  ))}
</nav>

<style>
  .app-bottom-nav svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
