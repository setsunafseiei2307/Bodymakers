---
import ToolLayout from '../../layouts/ToolLayout.astro';
import TodayTool from '../../components/react/TodayTool';
import '../../styles/strength.css';
import '../../styles/tools.css';

/*
 * 今日。
 *
 * 見出しとリード文はコンポーネント側（TodayOverview）が日付つきで出すので、
 * ページ側では枠だけを用意する。個人の記録画面なので検索結果には出さない。
 */

const title = '今日';
const description =
  '今日のトレーニング、食事、体重をひとつにまとめ、次にやることをすぐ確認・記録できます。';
---

<ToolLayout title={title} description={description} toolKey="today" noindex hideHeading
  privacy="保存した記録はこのブラウザにだけ残ります。サーバーへの送信はありません。">
  <TodayTool client:load />
</ToolLayout>
