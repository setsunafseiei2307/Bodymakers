---
import { sitePath, url } from '../lib/url';

const pathname = sitePath(Astro.url.pathname);
const items = [
  { href: '/tools/today', label: 'Today', icon: '◉' },
  { href: '/plan', label: 'Plan', icon: '◈' },
  { href: '/record', label: 'Record', icon: '▦' },
  { href: '/library', label: 'Library', icon: '▤' },
] as const;

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<nav class="app-bottom-nav" aria-label="アプリナビゲーション">
  {items.map((item) => (
    <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
      <span aria-hidden="true">{item.icon}</span>
      <small>{item.label}</small>
    </a>
  ))}
</nav>
