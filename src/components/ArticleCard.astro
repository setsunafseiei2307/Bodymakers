---
import { CATEGORIES, type CategoryKey } from '../config/site';
import { formatDate, toISODate, type Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const category = CATEGORIES[article.data.category as CategoryKey];
---

<article class="article-card">
  <a class="article-card__link" href={`/articles/${article.id}`}>
    <div class="article-card__meta">
      <span class="badge badge--brand">{category.label}</span>
      <time datetime={toISODate(article.data.publishedAt)}>
        {formatDate(article.data.publishedAt)}
      </time>
    </div>
    <h3 class="article-card__title">{article.data.title}</h3>
    <p class="article-card__description">{article.data.description}</p>
    {
      article.data.draft && (
        <p class="article-card__draft">下書き（本番ビルドには含まれません）</p>
      )
    }
  </a>
</article>

<style>
  .article-card {
    height: 100%;
  }

  .article-card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .article-card__link:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: inherit;
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .article-card__title {
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .article-card__link:hover .article-card__title {
    color: var(--brand-text);
  }

  .article-card__description {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .article-card__draft {
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--warning-text);
    font-size: 0.75rem;
    font-weight: 700;
  }
</style>
