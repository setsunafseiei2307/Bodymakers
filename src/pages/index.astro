---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getFeaturedArticles } from '../lib/articles';
import { LEVELS, STANDARDS_SOURCE } from '../lib/strength/standards';
import { CATEGORIES, SITE_DESCRIPTION } from '../config/site';
import { TOOLS } from '../config/tools';
import AdSlot from '../components/AdSlot.astro';
import StrengthForm from '../components/react/StrengthForm';
import '../styles/tools.css';
import '../styles/strength.css';
import { url } from '../lib/url';
import Dashboard from '../components/react/Dashboard';

// 新着順ではなく、記事側で featured を立てたものを出す。
// 書いた順という運営の都合が、そのまま並びになるのを避けるため。
const articles = await getFeaturedArticles(4);
---

<BaseLayout description={SITE_DESCRIPTION}>
  {/* --- ヒーロー。説明を読ませてから遷移させるのではなく、その場で測ってもらう --- */}
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">登録不要・入力内容は送信されません</p>
      <h1 class="hero__title">
        なりたい身体から、<br />
        <span class="hero__accent">今日やることまで。</span>
      </h1>
      <p class="hero__lead">
        身体・筋力・食事・生活習慣を順に選ぶだけで、あなた用の12週間Planを作れます。
      </p>
      <p class="hero__actions"><a class="button button--lg" href={url('/start')}>身体づくり診断をはじめる</a></p>
      <p class="hero__sublead">まずBIG3の現在地だけ知りたい人はこちら</p>
      <div class="hero__tool">
        <StrengthForm client:load quickStart />
      </div>
    </div>
  </section>

  <div class="container dashboard-wrap">
    <Dashboard client:load />
  </div>

  <div class="container">
    {/* --- 診断の中身の説明 --- */}
    <section class="section">
      <div class="section-head">
        <h2>診断で分かること</h2>
      </div>
      <div class="feature-grid">
        <div class="feature slip">
          <span class="feature__number">01</span>
          <h3 class="feature__title">推定1RM</h3>
          <p class="feature__text">
            挙上重量とレップ数から、1回だけ挙げられる最大重量を推定します。
            7つの換算式の平均を使い、式ごとのばらつきも表示します。
          </p>
        </div>
        <div class="feature slip">
          <span class="feature__number">02</span>
          <h3 class="feature__title">体重帯内パーセンタイル</h3>
          <p class="feature__text">
            同じ性別・同じくらいの体重の競技者の中で、上位何%に入るかを表示します。
            体重階級で区切らず、実測体重に合わせて基準値を補間します。
          </p>
        </div>
        <div class="feature slip">
          <span class="feature__number">03</span>
          <h3 class="feature__title">5段階レベル</h3>
          <p class="feature__text">
            初心者から エリートまでの5段階で判定し、
            次のレベルまであと何kg必要かも示します。
          </p>
        </div>
        <div class="feature slip">
          <span class="feature__number">04</span>
          <h3 class="feature__title">弱点部位の指摘</h3>
          <p class="feature__text">
            3種目の順位を比べ、他より伸びていない種目と、
            そこで主に使われる部位を指摘します。
          </p>
        </div>
      </div>
    </section>

    {/* --- レベルの見え方（診断前に期待値を合わせる） --- */}
    <section class="section">
      <div class="section-head">
        <h2>5段階レベル</h2>
        <a href={url('/sources')}>判定基準の詳細</a>
      </div>
      <ol class="level-ladder">
        {
          LEVELS.map((level) => (
            <li class={`level-ladder__item lv-${level.id}`}>
              <span class="level-ladder__bar" />
              <span class="level-ladder__label">{level.label}</span>
              <span class="level-ladder__desc">{level.description}</span>
            </li>
          ))
        }
      </ol>
      <p class="section__note">
        判定基準は{STANDARDS_SOURCE.name}が公開する公式競技会の記録
        （{STANDARDS_SOURCE.license}）から算出しています。母集団は競技会出場者のため、
        一般のジム利用者より全体に高い水準です。結果はあくまで目安として扱ってください。
      </p>
    </section>

    {/* 広告枠（トップページ中段）。現時点では広告タグを読み込まない。 */}
    <AdSlot id="home-mid" />

    {/* --- ツール --- */}
    <section class="section">
      <div class="section-head">
        <h2>計算ツール</h2>
        <a href={url('/tools')}>ツール一覧へ</a>
      </div>
      <p class="section__lead">
        すべてブラウザの中だけで計算します。登録不要。保存した計画と記録はこの端末だけに残ります。
      </p>
      <ul class="home-tools">
        {
          TOOLS.filter((tool) => tool.key !== 'rpe').map((tool) => (
            <li>
              <a class="home-tool" href={url(tool.href)}>
                <span class="home-tool__code">{tool.code}</span>
                <span class="home-tool__name">{tool.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* --- 記事 --- */}
    <section class="section">
      <div class="section-head">
        <h2>まず読むなら</h2>
        <a href={url('/articles')}>記事一覧へ</a>
      </div>
      {
        articles.length > 0 ? (
          <div class="card-grid">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        ) : (
          <div class="empty">
            <strong class="empty__title">記事はまだありません</strong>
            <p>src/content/articles/ に Markdown を置くと、ここに一覧が出ます。</p>
          </div>
        )
      }
    </section>

    {/* --- カテゴリ --- */}
    <section class="section">
      <div class="section-head">
        <h2>カテゴリから探す</h2>
      </div>
      <ul class="category-list">
        {
          Object.values(CATEGORIES).map((category) => (
            <li>
              <a class="category-list__link" href={url(`/articles/category/${category.slug}`)}>
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /* --- ヒーロー --- */

  .hero {
    padding-block: var(--s6) var(--s7);
    border-bottom: 3px solid var(--rule);
  }

  .hero__inner {
    max-width: 40rem;
  }

  .hero__eyebrow {
    display: inline-block;
    padding: 0.15rem var(--s3);
    border: 1px solid var(--signal);
    color: var(--signal);
    font-size: 0.6875rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .hero__title {
    margin-top: var(--s4);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 900;
    line-height: 1.2;
  }

  .hero__accent {
    color: var(--signal);
  }

  .hero__lead {
    margin-top: var(--s4);
    color: var(--body);
    font-size: 1rem;
    line-height: 1.9;
  }

  .hero__actions { margin-top: var(--s5); }
  .hero__actions .button { text-decoration: none; }
  .hero__sublead { margin-top: var(--s6); color: var(--muted); font-size: .8125rem; font-weight: 700; }

  /* すぐBIG3だけを見たい人のため、既存の診断フォームは残す。 */
  .hero__tool {
    margin-top: var(--s3);
  }

  .dashboard-wrap {
    padding-top: var(--s6);
  }

  /* --- セクション共通 --- */

  .section {
    padding-block: var(--s7);
  }

  .section + .section {
    border-top: 1px solid var(--hair);
  }

  .section__note {
    margin-top: var(--s4);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  /* --- 特徴 --- */

  .feature-grid {
    display: grid;
    gap: var(--s4);
  }

  @media (min-width: 40rem) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature__number {
    display: block;
    margin-bottom: var(--s2);
    color: var(--signal);
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .feature__title {
    margin-bottom: var(--s2);
    font-size: 1.0625rem;
  }

  .feature__text {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  /* --- レベルの階段 --- */

  .level-ladder {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: level;
  }

  .level-ladder__item {
    display: grid;
    grid-template-columns: 0.5rem 5rem 1fr;
    align-items: center;
    gap: var(--s3);
    padding: var(--s3) var(--s4);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .level-ladder__bar {
    width: 0.5rem;
    height: 2rem;
    border-radius: var(--r-full);
    background: var(--lv);
  }

  .level-ladder__label {
    color: var(--lv);
    font-size: 1rem;
    font-weight: 800;
  }

  .level-ladder__desc {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .section__lead {
    margin-bottom: var(--s4);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .home-tools {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--hair);
    border: 1px solid var(--hair);
  }

  @media (min-width: 34rem) {
    .home-tools { grid-template-columns: 1fr 1fr; }
  }

  .home-tool {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
    padding: var(--s4);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .home-tool:hover { background: var(--inset); }
  .home-tool:hover .home-tool__name { color: var(--signal); }

  .home-tool__code {
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .home-tool__name { font-size: 0.9375rem; font-weight: 900; }

  /* --- 記事グリッド --- */

  .card-grid {
    display: grid;
    gap: var(--s4);
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    }
  }

  /* --- カテゴリ --- */

  .category-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-list__link {
    display: inline-block;
    padding: var(--s3) var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--body);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
  }

  .category-list__link:hover {
    border-color: var(--signal);
    background: var(--signal-soft);
    color: var(--signal);
  }
</style>
