---
import ToolLayout from '../../layouts/ToolLayout.astro';
import FoodTool from '../../components/react/FoodTool';
import DishPanel from '../../components/react/DishPanel';
import '../../styles/tools.css';

const title = '食品の栄養価を調べる';
const description = '日本食品標準成分表の全2,538食品と材料内訳つき料理31品からカロリーとPFCを検索し、そのまま今日の食事へ追加できます。';
---

<ToolLayout title={title} description={description} toolKey="foods"
  lead="食品名で検索すると、カロリーとPFCが出ます。">
  <FoodTool client:load />
  <DishPanel client:visible />
</ToolLayout>
