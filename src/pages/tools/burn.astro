---
import ToolLayout from '../../layouts/ToolLayout.astro';
import BurnTool from '../../components/react/BurnTool';
import '../../styles/strength.css';
import '../../styles/tools.css';

const title = '運動の消費カロリー';
const description =
  'ウォーキングやランニングで何kcal使ったかを、メッツ（運動強度）から計算します。結果は「ごはん茶碗◯杯ぶん」のように食べ物で言い換えます。逆に「ご飯1杯を消費するには何分歩くか」も出せます。';
---

<ToolLayout title={title} description={description} toolKey="burn"
  lead="運動の種類と時間から、使ったカロリーを計算します。">
  <BurnTool client:load />
</ToolLayout>
